# Public browser port.
OPERAI_PORT=8080

# Exported DINOv3 ONNX model on the Docker host. The INT8 artifact is the
# smallest CPU-oriented default; switch to the float model if the target ONNX
# Runtime build does not support a quantized operator.
OPERAI_MODEL_PATH=./models/operai_eye_dinov3.int8.onnx

# Pinned NVIDIA Triton container release.
TRITON_IMAGE_TAG=26.06-py3
TRITON_TIMEOUT_SECONDS=120
